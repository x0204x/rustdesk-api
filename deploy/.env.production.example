# Copy this file to .env.production on the server.
# Never commit the real .env.production file.

# During development this may use :develop.
# Before production, replace it with an immutable verified stable digest.
RUSTDESK_API_IMAGE=ghcr.io/x0204x/rustdesk-api:develop

# PUBLIC key only. Never point this to id_ed25519.
RUSTDESK_PUBLIC_KEY_FILE=/opt/rustdesk-oss/data/id_ed25519.pub

RUSTDESK_API_LANG=zh-TW

RUSTDESK_API_APP_WEB_CLIENT=0
RUSTDESK_API_APP_REGISTER=false
RUSTDESK_API_APP_SHOW_SWAGGER=0

RUSTDESK_API_GIN_API_ADDR=0.0.0.0:21114
RUSTDESK_API_GIN_MODE=release
RUSTDESK_API_GORM_TYPE=sqlite
RUSTDESK_API_LOGGER_PATH=/app/runtime/log.txt

RUSTDESK_API_LDAP_ENABLE=false
RUSTDESK_API_PROXY_ENABLE=false

RUSTDESK_API_RUSTDESK_ID_SERVER=rustdesk.djbala.cc:21116
RUSTDESK_API_RUSTDESK_RELAY_SERVER=rustdesk.djbala.cc:21117
RUSTDESK_API_RUSTDESK_API_SERVER=https://api-rustdesk.djbala.cc
RUSTDESK_API_RUSTDESK_WS_HOST=wss://web-rustdesk.djbala.cc
RUSTDESK_API_RUSTDESK_KEY_FILE=/run/secrets/rustdesk_id_ed25519_pub
RUSTDESK_API_RUSTDESK_PERSONAL=1

# Generate on the server:
# openssl rand -hex 32
# Never paste the generated value into chat or commit it to Git.
RUSTDESK_API_JWT_KEY=REPLACE_WITH_A_RANDOM_64_HEX_VALUE
